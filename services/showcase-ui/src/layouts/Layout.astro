---
interface Props {
  title?: string;
}

const { title = 'GCP Enterprise Agent Platform – RFP & Compliance Inspector' } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- MANDATORY: Declare support for both light and dark themes -->
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* Raw light & dark palette tokens */
    --bg-light: #f6f8fc;
    --bg-dark: #0d1117;
    --surface-light: #ffffff;
    --surface-dark: #161b22;
    --surface-muted-light: #eef2f8;
    --surface-muted-dark: #1f2630;
    --text-light: #17202a;
    --text-dark: #e6edf3;
    --text-muted-light: #516071;
    --text-muted-dark: #9ba8b8;
    --border-light: #d0d9e4;
    --border-dark: #30363d;

    --brand-accent-light: #1a56db;
    --brand-accent-dark: #75a8ff;
    --brand-accent-text-light: #ffffff;
    --brand-accent-text-dark: #071326;

    --scrollbar-track-light: #eaeff5;
    --scrollbar-track-dark: #161b22;
    --scrollbar-thumb-light: #6b7280;
    --scrollbar-thumb-dark: #8b949e;

    /* Semantic resolved tokens (light defaults + media fallback) */
    --bg: var(--bg-light);
    --surface: var(--surface-light);
    --surface-muted: var(--surface-muted-light);
    --text: var(--text-light);
    --text-muted: var(--text-muted-light);
    --border: var(--border-light);
    --brand-accent: var(--brand-accent-light);
    --brand-accent-text: var(--brand-accent-text-light);
    --scrollbar-track: var(--scrollbar-track-light);
    --scrollbar-thumb: var(--scrollbar-thumb-light);

    @media (prefers-color-scheme: dark) {
      --bg: var(--bg-dark);
      --surface: var(--surface-dark);
      --surface-muted: var(--surface-muted-dark);
      --text: var(--text-dark);
      --text-muted: var(--text-muted-dark);
      --border: var(--border-dark);
      --brand-accent: var(--brand-accent-dark);
      --brand-accent-text: var(--brand-accent-text-dark);
      --scrollbar-track: var(--scrollbar-track-dark);
      --scrollbar-thumb: var(--scrollbar-thumb-dark);
    }

    @supports (color: light-dark(white, black)) {
      --bg: light-dark(var(--bg-light), var(--bg-dark));
      --surface: light-dark(var(--surface-light), var(--surface-dark));
      --surface-muted: light-dark(var(--surface-muted-light), var(--surface-muted-dark));
      --text: light-dark(var(--text-light), var(--text-dark));
      --text-muted: light-dark(var(--text-muted-light), var(--text-muted-dark));
      --border: light-dark(var(--border-light), var(--border-dark));
      --brand-accent: light-dark(var(--brand-accent-light), var(--brand-accent-dark));
      --brand-accent-text: light-dark(var(--brand-accent-text-light), var(--brand-accent-text-dark));
      --scrollbar-track: light-dark(var(--scrollbar-track-light), var(--scrollbar-track-dark));
      --scrollbar-thumb: light-dark(var(--scrollbar-thumb-light), var(--scrollbar-thumb-dark));
    }

    /* MANDATORY: Apply color-scheme to :root for viewport-wide theming */
    color-scheme: light dark;
    accent-color: var(--brand-accent);
    scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);

    --status-green-bg: #dcfce7;
    --status-green-fg: #14532d;
    --status-yellow-bg: #fef9c3;
    --status-yellow-fg: #713f12;
    --status-red-bg: #fee2e2;
    --status-red-fg: #7f1d1d;

    @media (prefers-color-scheme: dark) {
      --status-green-bg: #0f3d24;
      --status-green-fg: #86efac;
      --status-yellow-bg: #422b08;
      --status-yellow-fg: #fde047;
      --status-red-bg: #451218;
      --status-red-fg: #fca5a5;
    }

    @supports (color: light-dark(white, black)) {
      --status-green-bg: light-dark(#dcfce7, #0f3d24);
      --status-green-fg: light-dark(#14532d, #86efac);
      --status-yellow-bg: light-dark(#fef9c3, #422b08);
      --status-yellow-fg: light-dark(#713f12, #fde047);
      --status-red-bg: light-dark(#fee2e2, #451218);
      --status-red-fg: light-dark(#7f1d1d, #fca5a5);
    }
  }

  /* Legacy scrollbar fallback for older WebKit/Blink engines */
  @supports not (scrollbar-color: auto) {
    .scroller {
      scrollbar-width: auto;
    }
    .scroller::-webkit-scrollbar {
      width: 10px;
      height: 10px;
    }
    .scroller::-webkit-scrollbar-thumb {
      background: var(--scrollbar-thumb);
      border-radius: 6px;
    }
    .scroller::-webkit-scrollbar-track {
      background: var(--scrollbar-track);
    }
  }

  /* Fallback styling for browsers without accent-color */
  @supports not (accent-color: var(--brand-accent)) {
    input[type='checkbox'].brand-checkbox {
      position: absolute !important;
      clip-path: inset(50%) !important;
      overflow: hidden !important;
      width: 1px !important;
      height: 1px !important;
      margin: -1px !important;
      padding: 0 !important;
      border: 0 !important;
      white-space: nowrap !important;
    }
    .checkbox-label {
      position: relative;
      padding-inline-start: 1.75rem;
      cursor: pointer;
    }
    input[type='checkbox'].brand-checkbox + span::before {
      content: '';
      position: absolute;
      inset-inline-start: 0;
      inset-block-start: 50%;
      transform: translateY(-50%);
      inline-size: 1.1rem;
      block-size: 1.1rem;
      border: 2px solid var(--border);
      background: var(--surface);
      border-radius: 4px;
    }
    input[type='checkbox'].brand-checkbox:checked + span::before {
      background: var(--brand-accent);
      border-color: var(--brand-accent);
    }
    input[type='checkbox'].brand-checkbox:focus-visible + span::before {
      outline: 2px solid var(--brand-accent);
      outline-offset: 2px;
    }
    progress {
      -webkit-appearance: none;
      -moz-appearance: none;
      appearance: none;
      border: none;
      background: var(--surface-muted);
      border-radius: 999px;
      block-size: 8px;
    }
    progress::-webkit-progress-bar {
      background: var(--surface-muted);
      border-radius: 999px;
    }
    progress::-webkit-progress-value {
      background: var(--brand-accent);
      border-radius: 999px;
    }
    progress::-moz-progress-bar {
      background: var(--brand-accent);
      border-radius: 999px;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    inline-size: 100%;
    min-block-size: 100dvb;
    background-color: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.5;
  }

  pre,
  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    color-scheme: dark;
    accent-color: var(--brand-accent-dark);
  }
</style>
